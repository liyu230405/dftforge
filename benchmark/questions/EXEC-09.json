      "id": "c4",
      "kind": "assertion",
      "weight": 0.5,
      "rule": "must_match",
      "args": {
        "patterns": [
          "Cl.*?3p|Cl.*?p.*?(价带|VBM|主导)"
        ]
      }
    },
    {
      "id": "c5",
      "kind": "audit",
      "weight": 1.0,
      "rule": "gating_all_pass"
    }
