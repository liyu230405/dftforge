        "limit": 0.01,
        "unit": "states/eV/cell"
      }
    },
    {
      "id": "c3",
      "kind": "assertion",
      "weight": 1.0,
      "rule": "must_match",
      "args": {
        "patterns": [
          "(NaCl|氯化钠).*?(绝缘|带隙)|(宽|大).*?带隙|EF.*?(带隙|gap).*?(中|内)"
