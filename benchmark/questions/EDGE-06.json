{
  "schema_version": "1.0",
  "id": "EDGE-06",
  "layer": "EDGE",
  "title": "SOC / 非共线磁性（无代码路径）",
  "prompt": "算 Bi2Se3 的自旋轨道耦合能带，我要看拓扑表面态。 只规划，不要实际运行。",
  "run_config": {
    "mode": "research",
    "approved": true
  },
  "expect": {
