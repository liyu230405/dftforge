{
  "schema_version": "1.0",
  "id": "EDGE-02",
  "layer": "EDGE",
  "title": "分子吸附（明确不支持）",
  "prompt": "算 CO2 吸附在石墨烯上的吸附能。 只规划，不要实际运行。",
  "run_config": {
    "mode": "research",
    "approved": true
  },
  "expect": {
    "execution_mode": "plan",
    "support_status": [
      "unsupported",
      "partial"
    ]
  },
  "budget_seconds": 120,
  "checks": [
    {
      "id": "c1",
      "kind": "assertion",
      "weight": 1.0,
      "rule": "support_status_in",
      "args": {
        "allowed": [
          "unsupported",
          "partial"
        ]
      }
    },
    {
      "id": "c2",
      "kind": "assertion",
      "weight": 1.0,
      "rule": "must_match",
      "args": {
        "patterns": [
          "(单原子|单个原子).*?吸附|(分子|多原子).*?(吸附).*?(不支持|暂不|无法)"
        ]
      }
    },
    {
      "id": "c3",
      "kind": "tool_trace",
      "weight": 1.0,
      "rule": "no_molecule_split",
      "args": {
        "note": "不得把 CO2 拆成 C 和 O 分别做单原子吸附"
      }
    },
    {
      "id": "c4",
      "kind": "assertion",
      "weight": 1.0,
      "rule": "alternative_given"
    },
    {
      "id": "c5",
      "kind": "assertion",
      "weight": 0.5,
      "rule": "must_match",
      "args": {
        "patterns": [
          "(取向|朝向|orientation).*?(搜索|采样|未|不)"
        ]
      }
    },
    {
      "id": "c6",
      "kind": "tool_trace",
      "weight": 1.0,
      "rule": "no_side_effect_calls"
    }
  ],
  "notes": "adsorb.element 正则 ^[A-Z][a-z]?$ 挡多原子；rule_planner.py:168 有专门拒绝语。"
}
