{
  "schema_version": "1.0",
  "id": "EDGE-03",
  "layer": "EDGE",
  "title": "形成能参考态缺口",
  "prompt": "算 ZnS 相对于 Zn 和 S 参考态的形成能。 只规划，不要实际运行。",
  "run_config": {
    "mode": "research",
    "approved": true
  },
  "expect": {
    "execution_mode": "plan",
    "support_status": [
      "unsupported",
      "partial"
    ]
  },
  "budget_seconds": 120,
  "checks": [
    {
      "id": "c1",
      "kind": "assertion",
      "weight": 1.0,
      "rule": "support_status_in",
      "args": {
        "allowed": [
          "unsupported",
          "partial"
        ]
      }
    },
    {
      "id": "c2",
      "kind": "assertion",
      "weight": 1.0,
      "rule": "must_match",
      "args": {
        "patterns": [
          "\\bS\\b.*?(参考态|reference)|(参考态|reference).*?\\bS\\b|缺.*?S.*?(参考|reference)"
        ]
      }
    },
    {
      "id": "c3",
      "kind": "assertion",
      "weight": 1.0,
      "rule": "no_fabricated_number",
      "args": {
        "fields": [
          "formation_energy",
          "chemical_potential"
        ]
      }
    },
    {
      "id": "c4",
      "kind": "assertion",
      "weight": 1.0,
      "rule": "alternative_given"
    },
    {
      "id": "c5",
      "kind": "assertion",
      "weight": 0.5,
      "rule": "must_match",
      "args": {
        "patterns": [
          "(ZnS).*?(可以|能|支持).*?(SCF|能带|结构)|(SCF|能带).*?(可以|能|支持)"
        ]
      }
    },
    {
      "id": "c6",
      "kind": "tool_trace",
      "weight": 1.0,
      "rule": "no_side_effect_calls"
    }
  ],
  "notes": "ZnS 在 MATERIAL_DB 但 S 不在 REFERENCE_PHASES 的 33 元素里。考'库里有≠都能算'。"
}
