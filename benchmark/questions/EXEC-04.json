{
  "schema_version": "1.0",
  "id": "EXEC-04",
  "layer": "EXEC",
  "title": "Fe 三磁序比较",
  "prompt": "用 workflow.magnetic_compare 比较 bcc Fe 的 NM/FM/AFM 三种共线初态的能量和实际磁矩，1x1x1 常规胞、initial_moment_muB=2.2，不做结构优化。 直接运行本地 QE。本轮是有限参数下的链路验证，数值未经过收敛测试；只执行当前任务，不添加扫描。",
  "run_config": {
    "mode": "research",
    "approved": true,
    "accuracy": "custom",
    "ecutwfc": 35,
    "ecutrho": 280,
    "kpoints": [
      4,
      4,
      4,
      1,
      1,
      1
    ]
  },
  "expect": {
    "execution_mode": "execute"
  },
  "budget_seconds": 180,
  "checks": [
    {
      "id": "c1",
      "kind": "tool_trace",
      "weight": 1.0,
      "rule": "nodes_succeeded",
      "args": {
        "nodes": [
          "nm",
          "fm",
          "afm"
        ]
      }
    },
    {
      "id": "c2",
      "kind": "numeric",
      "weight": 1.0,
      "rule": "lowest_energy_order",
      "args": {
        "field": "magnetic_orders",
        "expected": "FM"
      }
    },
    {
      "id": "c3",
      "kind": "numeric",
      "weight": 1.0,
      "rule": "graded_relative",
      "args": {
        "field": "fm_total_moment_muB",
        "value": 5.35,
        "tolerance": 0.1,
        "unit": "muB/2atoms"
      }
    },
    {
      "id": "c4",
      "kind": "assertion",
      "weight": 1.0,
      "rule": "must_match",
      "args": {
        "patterns": [
          "AFM.*?(总磁矩|total).*?(0|零|接近零).*?(绝对|absolute).*?(非零|不为零)|绝对磁矩.*?(非零|不为零)"
        ]
      }
    },
    {
      "id": "c5",
      "kind": "assertion",
      "weight": 1.0,
      "rule": "must_match",
      "args": {
        "patterns": [
          "(一种|单一|仅).*?(AFM|反铁磁|交替|子格)|AFM.*?(初态|初始|不等于|≠).*?(基态|全局|穷举)"
        ]
      }
    },
    {
      "id": "c6",
      "kind": "audit",
      "weight": 1.0,
      "rule": "gating_all_pass"
    }
  ],
  "notes": "GT FM 总磁矩 5.35 μB/2 原子（2026-09-22 实测）。"
}
