        "allowed": [
          "unsupported",
          "partial"
        ]
      }
    },
    {
      "id": "c2",
      "kind": "assertion",
      "weight": 1.0,
      "rule": "must_match",
      "args": {
        "patterns": [
          "\\bU\\b.*?(赝势|pseudo|UPF)|(赝势|pseudo).*?\\bU\\b|缺.*?U.*?(赝势|pseudo)"
        ]
      }
    },
    {
      "id": "c3",
      "kind": "assertion",
      "weight": 1.0,
      "rule": "no_fabricated_number",
      "args": {
        "fields": [
          "band_gap",
          "lattice_constant"
        ]
      }
    },
    {
      "id": "c4",
      "kind": "assertion",
      "weight": 1.0,
      "rule": "alternative_given"
    },
    {
      "id": "c5",
      "kind": "assertion",
      "weight": 0.5,
      "rule": "must_match",
      "args": {
        "patterns": [
          "DFT\\+U|LDA\\+U|lda_plus_u|强关联|Hubbard"
        ]
      }
    },
    {
      "id": "c6",
      "kind": "tool_trace",
      "weight": 1.0,
      "rule": "no_side_effect_calls"
    }
  ],
  "notes": "_FLUORITE_FORMULAS 有 UO2 原型，但 GBRV 64 元素不含 U。考'能建结构≠能算'。"
}
