{
  "schema_version": "1.0",
  "id": "EDGE-04",
  "layer": "EDGE",
  "title": "赝势缺口（原型有但赝势没有）",
  "prompt": "算 UO2 的结构优化和带隙。 只规划，不要实际运行。",
  "run_config": {
    "mode": "research",
