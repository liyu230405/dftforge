{
  "schema_version": "1.0",
  "id": "EDGE-05",
  "layer": "EDGE",
  "title": "化合物 + 单元素化学势模式（语义冲突）",
  "prompt": "算 MgO 里一个 O 空位的形成能，化学势用 same_method_bulk_per_atom 模式。 只规划，不要实际运行。",
  "run_config": {
    "mode": "research",
    "approved": true
  },
  "expect": {
    "execution_mode": "plan",
    "support_status": [
      "unsupported",
      "partial"
    ]
  },
  "budget_seconds": 120,
  "checks": [
    {
      "id": "c1",
      "kind": "assertion",
      "weight": 1.0,
      "rule": "support_status_in",
      "args": {
        "allowed": [
          "unsupported",
          "partial"
        ]
      }
    },
    {
      "id": "c2",
      "kind": "assertion",
      "weight": 1.0,
      "rule": "must_match",
      "args": {
        "patterns": [
          "same_method_bulk_per_atom.*?(单元素|纯元素|单一元素)|(单元素|纯元素).*?same_method|化合物.*?(不适用|无效|不能)"
        ]
      }
    },
    {
      "id": "c3",
      "kind": "assertion",
      "weight": 1.0,
      "rule": "alternative_given"
    },
    {
      "id": "c4",
      "kind": "assertion",
      "weight": 1.0,
      "rule": "must_match",
      "args": {
        "patterns": [
          "(化学势|μ|mu).*?(窗口|范围|区间|极限)|富(氧|O|Mg).*?(极限|条件)"
        ]
      }
    },
    {
      "id": "c5",
      "kind": "tool_trace",
      "weight": 1.0,
      "rule": "no_side_effect_calls"
    }
  ],
  "notes": "same_method_bulk_per_atom 只对单元素有效；MgO 移除 O 后 E/N 不是 O 的化学势。"
}
