{
  "schema_version": "1.0",
  "id": "EXEC-10",
  "layer": "EXEC",
  "title": "收敛扫描实跑",
  "prompt": "用 workflow.convergence 对 Si 做 ecutwfc 收敛扫描，扫 20/30/40/50 Ry，k 点固定 4x4x4，阈值 1 meV/atom。 直接运行本地 QE。本轮是有限参数下的链路验证，数值未经过收敛测试；只执行当前任务，不添加扫描。",
  "run_config": {
    "mode": "research",
    "approved": true,
    "accuracy": "custom"
  },
  "expect": {
    "execution_mode": "execute"
  },
  "budget_seconds": 180,
  "checks": [
    {
      "id": "c1",
      "kind": "tool_trace",
      "weight": 1.0,
      "rule": "node_count",
      "args": {
        "minimum": 4
      }
    },
    {
      "id": "c2",
      "kind": "numeric",
      "weight": 1.0,
      "rule": "selected_within_threshold",
      "args": {
        "field": "convergence_selection",
        "threshold_mev_per_atom": 1.0
      }
    },
    {
      "id": "c3",
      "kind": "assertion",
      "weight": 1.0,
      "rule": "reference_is_highest",
      "args": {
        "note": "参考点须是最高截断点，不能自己跟自己比"
      }
    },
    {
      "id": "c4",
      "kind": "assertion",
      "weight": 1.0,
      "rule": "must_match",
      "args": {
        "patterns": [
          "能量收敛.*?(不等于|≠|不代表|不意味).*?(带隙|物性|声子|其他)|(带隙|物性|声子).*?(另需|单独|独立).*?收敛"
        ]
      }
    },
    {
      "id": "c5",
      "kind": "audit",
      "weight": 1.0,
      "rule": "gating_all_pass"
    }
  ],
  "notes": "收敛扫描真实执行，选点规则可核验。"
}
