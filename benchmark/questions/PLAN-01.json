{
  "schema_version": "1.0",
  "id": "PLAN-01",
  "layer": "PLAN",
  "title": "单模板路由：结构优化",
  "prompt": "帮我优化金刚石硅的结构，我要平衡晶格常数、残余力和压力。 只规划，不要实际运行。",
  "run_config": {
    "mode": "research",
    "approved": true
  },
  "expect": {
    "execution_mode": "plan",
    "support_status": [
      "complete"
    ]
  },
  "budget_seconds": 120,
  "checks": [
    {
      "id": "c1",
      "kind": "tool_trace",
      "weight": 1.0,
      "rule": "template_used",
      "args": {
        "template_id": "t1_vc_relax"
      }
    },
    {
      "id": "c2",
      "kind": "tool_trace",
      "weight": 1.0,
      "rule": "no_side_effect_calls"
    },
    {
      "id": "c3",
      "kind": "assertion",
      "weight": 1.0,
      "rule": "must_match",
      "args": {
        "patterns": [
          "(vc-?relax|变胞|可变晶胞).*?(晶胞|cell|晶格).*?(优化|放开|自由)|固定晶胞.*?relax|relax.*?固定.*?(晶胞|cell)"
        ]
      }
    },
    {
      "id": "c4",
      "kind": "assertion",
      "weight": 1.0,
      "rule": "must_match",
      "args": {
        "patterns": [
          "(力|force).*?(压力|应力|stress|pressure)|(压力|应力|stress|pressure).*?(力|force)"
        ]
      }
    },
    {
      "id": "c5",
      "kind": "assertion",
      "weight": 1.0,
      "rule": "support_status_in",
      "args": {
        "allowed": [
          "complete"
        ]
      }
    }
  ],
  "notes": "最基础的路由题。选 t1_vc_relax 而非固定晶胞的 relax。"
}
