{
  "template_id": "t2_bands",
  "description": "Band structure: scf -> nscf -> bands.x with cross-node verification",
  "inputs": {
    "_parameters_locked": false,
    "_source_lock": null,
    "material": "Si",
    "ecutwfc": null,
    "ecutrho": null,
    "kpoints": null,
    "nbnd": null,
    "nkpoints_bands": 100,
    "structure": null
  },
  "outputs": {
    "scf_energy_ry": "${nodes.scf.outputs.energy_ry}",
    "n_bands": "${nodes.bands.outputs.n_bands}",
    "band_gap_ev": "${nodes.bands.outputs.band_gap_ev}"
  },
  "nodes": [
    {
      "id": "scf",
      "tool": "qe",
      "params": {
        "calc": "scf",
        "_source_lock": "${inputs._source_lock}",
        "_parameters_locked": "${inputs._parameters_locked}",
        "material": "${inputs.material}",
        "ecutwfc": "${inputs.ecutwfc}",
        "ecutrho": "${inputs.ecutrho}",
        "nbnd": "${inputs.nbnd}",
        "kpoints": "${inputs.kpoints}",
        "structure": "${inputs.structure}"
      },
      "depends_on": [],
      "max_repair_attempts": 2
    },
    {
      "id": "nscf",
      "tool": "qe",
      "params": {
        "calc": "nscf",
        "_source_lock": "${inputs._source_lock}",
        "_parameters_locked": "${inputs._parameters_locked}",
        "material": "${inputs.material}",
        "ecutwfc": "${inputs.ecutwfc}",
        "ecutrho": "${inputs.ecutrho}",
        "nbnd": "${inputs.nbnd}",
        "nkpoints_bands": "${inputs.nkpoints_bands}",
        "structure": "${inputs.structure}"
      },
      "depends_on": [
        "scf"
      ],
      "max_repair_attempts": 2
    },
    {
      "id": "bands",
      "tool": "qe",
      "params": {
        "calc": "bands",
        "_source_lock": "${inputs._source_lock}",
        "_parameters_locked": "${inputs._parameters_locked}",
        "material": "${inputs.material}",
        "nkpoints_bands": "${inputs.nkpoints_bands}",
        "scf_stdout": "${nodes.scf.outputs.stdout_file}",
        "nscf_stdout": "${nodes.nscf.outputs.stdout_file}",
        "structure": "${inputs.structure}"
      },
      "depends_on": [
        "scf",
        "nscf"
      ],
      "max_repair_attempts": 1
    }
  ]
}
