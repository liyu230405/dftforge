{
  "template_id": "a2_abinit_dos",
  "description": "ABINIT density of states: scf (writes density) -> dos (total) + pdos (projected, prtdos 3), both reuse the density",
  "inputs": {
    "_parameters_locked": false,
    "material": "Si",
    "ecut": null,
    "ngkpt": null,
    "structure": null,
    "dos_ngkpt": null,
    "nband": null
  },
  "outputs": {
    "scf_energy_ev": "${nodes.scf.outputs.energy_ev}",
    "dos_at_fermi": "${nodes.dos.outputs.dos_at_fermi}",
    "n_energy_points": "${nodes.dos.outputs.n_energy_points}",
    "pdos_elements": "${nodes.pdos.outputs.elements}"
  },
  "nodes": [
    {
      "id": "scf",
      "tool": "abinit",
      "params": {
        "calc": "scf",
        "_parameters_locked": "${inputs._parameters_locked}",
        "material": "${inputs.material}",
        "ecut": "${inputs.ecut}",
        "ngkpt": "${inputs.ngkpt}",
        "structure": "${inputs.structure}",
        "nband": "${inputs.nband}"
      },
      "depends_on": [],
      "max_repair_attempts": 2
    },
    {
      "id": "dos",
      "tool": "abinit",
      "params": {
        "calc": "dos",
        "_parameters_locked": "${inputs._parameters_locked}",
        "material": "${inputs.material}",
        "ecut": "${inputs.ecut}",
        "structure": "${inputs.structure}",
        "nband": "${inputs.nband}",
        "ngkpt": "${inputs.dos_ngkpt}"
      },
      "depends_on": [
        "scf"
      ],
      "max_repair_attempts": 1
    },
    {
      "id": "pdos",
      "tool": "abinit",
      "params": {
        "calc": "pdos",
        "_parameters_locked": "${inputs._parameters_locked}",
        "material": "${inputs.material}",
        "ecut": "${inputs.ecut}",
        "structure": "${inputs.structure}",
        "nband": "${inputs.nband}",
        "ngkpt": "${inputs.dos_ngkpt}"
      },
      "depends_on": [
        "scf"
      ],
      "max_repair_attempts": 1
    }
  ]
}
