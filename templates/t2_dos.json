{
  "template_id": "t2_dos",
  "description": "Density of states: scf -> nscf -> dos.x + projwfc.x (total DOS + element-projected DOS)",
  "inputs": {
    "_parameters_locked": false,
    "_source_lock": null,
    "material": "Si",
    "ecutwfc": null,
    "ecutrho": null,
    "kpoints": null,
    "nbnd": null,
    "structure": null
  },
  "outputs": {
    "scf_energy_ry": "${nodes.scf.outputs.energy_ry}",
    "dos_at_fermi": "${nodes.dos.outputs.dos_at_fermi}",
    "pdos_elements": "${nodes.pdos.outputs.elements}"
  },
  "nodes": [
    {
      "id": "scf",
      "tool": "qe",
      "params": {
        "calc": "scf",
        "_source_lock": "${inputs._source_lock}",
        "_parameters_locked": "${inputs._parameters_locked}",
        "material": "${inputs.material}",
        "ecutwfc": "${inputs.ecutwfc}",
        "ecutrho": "${inputs.ecutrho}",
        "nbnd": "${inputs.nbnd}",
        "kpoints": "${inputs.kpoints}",
        "structure": "${inputs.structure}"
      },
      "depends_on": [],
      "max_repair_attempts": 2
    },
    {
      "id": "nscf",
      "tool": "qe",
      "params": {
        "calc": "nscf",
        "_source_lock": "${inputs._source_lock}",
        "_parameters_locked": "${inputs._parameters_locked}",
        "material": "${inputs.material}",
        "ecutwfc": "${inputs.ecutwfc}",
        "ecutrho": "${inputs.ecutrho}",
        "kpoints": "${inputs.kpoints}",
        "nbnd": "${inputs.nbnd}",
        "structure": "${inputs.structure}",
        "kmode": "uniform"
      },
      "depends_on": [
        "scf"
      ],
      "max_repair_attempts": 2
    },
    {
      "id": "dos",
      "tool": "qe",
      "params": {
        "calc": "dos",
        "_source_lock": "${inputs._source_lock}",
        "_parameters_locked": "${inputs._parameters_locked}",
        "material": "${inputs.material}",
        "scf_stdout": "${nodes.scf.outputs.stdout_file}",
        "nscf_stdout": "${nodes.nscf.outputs.stdout_file}",
        "structure": "${inputs.structure}"
      },
      "depends_on": [
        "scf",
        "nscf"
      ],
      "max_repair_attempts": 1
    },
    {
      "id": "pdos",
      "tool": "qe",
      "params": {
        "calc": "pdos",
        "_source_lock": "${inputs._source_lock}",
        "_parameters_locked": "${inputs._parameters_locked}",
        "material": "${inputs.material}",
        "structure": "${inputs.structure}"
      },
      "depends_on": [
        "nscf"
      ],
      "max_repair_attempts": 1
    }
  ]
}
