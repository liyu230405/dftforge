# DFT-Forge 环境配置模板
# 复制为 .env 后填写（.env 已被 .gitignore 排除，不会进仓库）

# ── LLM（OpenAI 兼容 API，用于自然语言 → 计算规划）────────────
# provider 选 openai-compat 时，下面三项生效
export DFT_FORGE_LLM_PROVIDER=openai-compat
export DFT_FORGE_LLM_BASE_URL=https://api.openai.com/v1
export DFT_FORGE_LLM_API_KEY=sk-xxxx
export DFT_FORGE_LLM_MODEL=gpt-4o-mini
# 国内可换：https://api.deepseek.com/v1 + deepseek-chat
#          https://dashscope.aliyuncs.com/compatible-mode/v1 + qwen-plus

# ── 算力（不填 = 本地执行）────────────────────────────────────
# QE 二进制目录（默认自动探测 PATH 中的 pw.x）
# export DFT_FORGE_QE_BIN=/path/to/qe/bin

# SSH 远程算力（BYOC：用户自带算力）
# export DFT_FORGE_EXECUTOR=ssh
# export DFT_FORGE_SSH_HOST=user@hpc.cluster.edu
# export DFT_FORGE_SSH_KEY=~/.ssh/id_rsa
# 集群调度器类型：slurm / pbs（不填 = 直连无调度器）
# export DFT_FORGE_SCHEDULER=slurm
